# Runtime
APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
# 仅在启用阿里云备用转写时填写公网 HTTPS 地址；只用硅基流动可留空
PUBLIC_BASE_URL=
LOG_LEVEL=info

# Storage and database
DATABASE_PATH=./data/app.db
DATA_DIR=./data

# Authentication (never commit the referenced secret)
JWT_SIGNING_KEY_FILE=./secrets/jwt.key
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
LOGIN_RATE_LIMIT_PER_MINUTE=5
RESOLVER_CACHE_TTL=6h

# Worker and media (used from M3 onward)
WORKER_CONCURRENCY=1
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MAX_VIDEO_BYTES=2147483648
RETENTION_VIDEO_HOURS=168
RETENTION_TEMP_HOURS=24

# ASR：用户输入抖音链接，服务端自动提取音频并上传硅基流动；Key 也可由管理员在网页配置
ASR_PROVIDER=siliconflow_sensevoice
ASR_MODEL=FunAudioLLM/SenseVoiceSmall
DASHSCOPE_ENDPOINT=https://dashscope.aliyuncs.com/api/v1
ASR_VOCABULARY_ID=
SILICONFLOW_API_KEY=
ALIYUN_DASHSCOPE_API_KEY=
DAILY_ASR_BUDGET_CNY=5
MONTHLY_ASR_BUDGET_CNY=20
ASR_PRICE_PER_MINUTE_CNY=
