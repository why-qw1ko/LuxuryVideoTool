# Runtime
APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
PUBLIC_BASE_URL=http://127.0.0.1:8080
LOG_LEVEL=info

# Storage and database (used from M1 onward)
DATABASE_PATH=./data/app.db
DATA_DIR=./data

# Authentication (used from M1 onward; never commit the referenced secret)
JWT_SIGNING_KEY_FILE=./secrets/jwt.key
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# Worker and media (used from M3 onward)
WORKER_CONCURRENCY=1
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MAX_VIDEO_BYTES=2147483648
RETENTION_VIDEO_HOURS=168
RETENTION_TEMP_HOURS=24

# ASR (used from M4 onward; leave real keys only in server secrets)
ASR_PROVIDER=aliyun_paraformer
ALIYUN_DASHSCOPE_API_KEY=
SILICONFLOW_API_KEY=
MONTHLY_ASR_BUDGET_CNY=20

